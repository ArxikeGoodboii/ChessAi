{
  "manifest_version": 3,
  "name": "ChessAi Study Helper",
  "version": "1.1.0",
  "description": "Reads chess positions on Chess.com analysis pages.",
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/analysis*",
        "https://chess.com/analysis*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}