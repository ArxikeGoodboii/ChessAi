{
  "manifest_version": 3,
  "name": "ChessAi Study Helper",
  "version": "1.2.2",
  "description": "Stockfish study helper for Chess.com analysis, computer bots, and lessons.",
  "browser_specific_settings": {
    "gecko": {
      "id": "chessai-study-helper@arxikegoodboii"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/analysis*",
        "https://chess.com/analysis*",
        "https://www.chess.com/play/computer*",
        "https://chess.com/play/computer*",
        "https://www.chess.com/lessons*",
        "https://chess.com/lessons*",
        "https://www.chess.com/coach*",
        "https://chess.com/coach*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}