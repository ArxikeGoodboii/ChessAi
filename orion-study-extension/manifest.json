{
  "manifest_version": 3,
  "name": "ChessAI Study Helper",
  "version": "1.3.1",
  "description": "A chess study helper with board, turn and move-history detection for practice and review.",
  "permissions": [],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chessai-study-helper@example.org",
      "strict_min_version": "109.0"
    }
  }
}
