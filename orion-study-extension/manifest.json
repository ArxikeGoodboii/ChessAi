{
  "manifest_version": 3,
  "name": "ChessAI Study Helper",
  "version": "1.4.7",
  "description": "A worker-free Chess.com helper with manual colour confirmation and automatic lightweight move analysis.",
  "permissions": [],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "engine.bundle.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chessai-study-helper@example.org",
      "strict_min_version": "109.0"
    }
  }
}
